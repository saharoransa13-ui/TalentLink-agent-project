# Optional OpenAI-compatible LLM extraction. Leave blank to use deterministic extraction.
# Example (Groq): OPENAI_BASE_URL=https://api.groq.com/openai/v1  and  OPENAI_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
LLM_TIMEOUT_SECONDS=35

# Optional local embedding-based matching. Install requirements-semantic.txt first.
ENABLE_EMBEDDING_MATCHING=false
# Multilingual model: supports Arabic and English questions in the RAG assistant.
# If you change this, rebuild data/chroma_db (see README).
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_PARTIAL_THRESHOLD=0.58

# Optional live job discovery via Adzuna API (register for credentials).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb

# Optional live course discovery via SerpAPI.
SERPAPI_API_KEY=
